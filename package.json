{
  "name": "sanboxx",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop shell for the SANBOXX endpoint scanner demo",
  "main": "dist/main/index.js",
  "scripts": {
    "start": "concurrently --kill-others-on-fail --names renderer,main,electron \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:renderer": "vite --config renderer/vite.config.mts --host 127.0.0.1 --port 5173 --strictPort",
    "dev:main": "tsc --project main/tsconfig.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 file:dist/main/index.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc --project main/tsconfig.json",
    "build:renderer": "tsc --project renderer/tsconfig.json && vite build --config renderer/vite.config.mts",
    "typecheck": "tsc --project main/tsconfig.json --noEmit && tsc --project renderer/tsconfig.json"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wait-on": "^9.1.0"
  }
}
